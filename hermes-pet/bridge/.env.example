# Copie ce fichier en .env (dans le même dossier) puis remplis les valeurs.
# Ne commite jamais le fichier .env : il contient des secrets.

# Adresse de l'API de Hermes (lancée par `hermes gateway`).
HERMES_URL=http://127.0.0.1:8642

# La même valeur que API_SERVER_KEY dans ~/.hermes/.env
HERMES_API_KEY=remplace-moi

# Nom de modèle envoyé à Hermes. Vérifie avec :
#   curl -H "Authorization: Bearer $HERMES_API_KEY" http://127.0.0.1:8642/v1/models
HERMES_MODEL=hermes-agent

# Jeton partagé avec la montre et le téléphone (32 caractères aléatoires).
# Génère-le avec :  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
PET_TOKEN=remplace-moi-par-un-jeton-aleatoire

# Port d'écoute de la passerelle sur ton réseau local.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

# Mode voix (optionnel, nécessite `pip install faster-whisper`).
# tiny = rapide, base = bon compromis, small = plus précis mais plus lent.
WHISPER_MODEL=base
PET_LANGUAGE=fr
